<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <!--
      I permessi dell'app (Fase 2, P0). Ognuno ha una riga in docs/sicurezza.md 4-bis E una in
      releaseManifestPolicy (gradle/verify-release-manifest.gradle), altrimenti la release non si assembla.
      Gli altri arrivano dai moduli: rete e WireGuard da :core-network, fotocamera da :core-qr, blocco app
      da :core-security, vibrazione da engine-ui, i quattro di WorkManager dalla libreria.

      - ACCESS_NETWORK_STATE: il motore delle regole (:core-rules) legge la rete in uso (docs/decisioni.md,
        "Cose tecniche da sistemare dopo la 1.5"). Lo dichiara anche :core-network.
      - POST_NOTIFICATIONS: problemi del NAS, approvazione di un nuovo dispositivo (all'admin). Chiesto al
        passo 9; facoltativo.
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: la richiesta diretta "Batteria illimitata" al passo 10, con
        verifica. Permesso normale; l'utente decide nel dialogo di sistema.
      - READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_MEDIA_VISUAL_USER_SELECTED: la Libreria del telefono e
        il backup; con "foto selezionate" l'app lavora in modalita' limitata (E-P1). Chiesti al passo 9.
      - ACCESS_MEDIA_LOCATION: copia fedele sul NAS (senza, il GPS e' oscurato e l'hash non coincide).
      - READ_EXTERNAL_STORAGE, SOLO fino all'SDK 32 (Fase 3, D22, proposta): su Android 10-12 e' l'unico permesso di
        lettura dei media (READ_MEDIA_* esiste da Android 13). Con maxSdkVersion=32 su Android 13+ non e' nemmeno
        dichiarato; verifyReleaseManifest pretende l'attributo.
      - RUN_USER_INITIATED_JOBS (Fase 4B, D29, approvato dall'utente il 15/10): le operazioni lunghe sui file del NAS avviate da un
        tocco (spostare 2.000 file) girano come lavoro avviato dall'utente (UIDT, Android 14+) nel NasOpsJobService, con notifica
        di avanzamento e "Ferma". Permesso normale, nessuna richiesta all'utente; sotto Android 14 e' ignorato.
  -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
  <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
  <uses-permission
      android:name="android.permission.READ_EXTERNAL_STORAGE"
      android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />

  <application
      android:name=".MyCloudGalleryApp"
      android:allowBackup="false"
      android:dataExtractionRules="@xml/data_extraction_rules"
      android:enableOnBackInvokedCallback="true"
      android:fullBackupContent="false"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.MyCloudGallery"
      android:usesCleartextTraffic="false"
      tools:targetApi="33">

    <!--
        L'unica activity e l'unico punto d'ingresso dell'utente (verifyReleaseManifest). singleTask: un
        secondo avvio dall'icona, da una notifica o da un widget riporta in primo piano l'istanza viva
        invece di impilarne una seconda con la sua navigazione. Il blocco app (AppLockGate) presume una
        sola activity: con due, ogni passaggio conterebbe come uscita dall'app.
        taskAffinity vuota (revisione 2, F13): nessun task di un'altra app con la nostra affinita' puo'
        ospitare l'activity (StrandHogg, soprattutto su Android 10).
    -->
    <activity
        android:name=".MainActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:taskAffinity="">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
        Fase 4B (D29): il JobService delle operazioni lunghe sui file del NAS avviate dall'utente (UIDT). NON esportato e protetto da
        BIND_JOB_SERVICE: lo lega solo il sistema (JobScheduler). verifyReleaseManifest e tools/check.ps1 pretendono il permesso per
        ogni *JobService. Dal P16 riprende dal diario locale le operazioni gia' confermate (mai una nuova), con la notifica di
        avanzamento e "Ferma"; "Ferma" arriva a un ricevitore registrato solo mentre il lavoro gira e NON esportato
        (RECEIVER_NOT_EXPORTED): nessun componente in piu' qui (docs/sicurezza.md 4-bis).
    -->
    <service
        android:name=".work.NasOpsJobService"
        android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />

    <!--
        androidx.profileinstaller (portato da Compose) dichiara questo receiver ESPORTATO, protetto dal
        solo permesso DUMP: serve a strumenti esterni (macrobenchmark, adb) per installare un profilo
        con un broadcast. Non ci serve e non deve restare un punto d'ingresso dell'app. L'installazione
        automatica del profilo all'avvio (ProfileInstallerInitializer) non passa da qui e resta attiva.
        Fase 3.5 (benchmark): il receiver si rimette solo nella variante benchmarkRelease, con il manifest di
        `src/benchmarkRelease/` (P9); `tools/check.ps1` verifica che la release non lo contenga.
    -->
    <receiver
        android:name="androidx.profileinstaller.ProfileInstallReceiver"
        tools:ignore="MissingClass"
        tools:node="remove" />

    <!--
        WorkManager (Fase 2): stesso caso del receiver qui sopra. DiagnosticsReceiver e' ESPORTATO (permesso
        DUMP) e serve solo a `adb shell am broadcast` per stampare lo stato dei lavori: non e' un punto
        d'ingresso che vogliamo. La diagnostica dei lavori la fa l'app (feature-diagnostics, getStopReason).
        SystemJobService invece resta: e' esportato ma protetto da BIND_JOB_SERVICE (solo il sistema puo'
        legarsi) ed e' ammesso esplicitamente in releaseManifestPolicy.
    -->
    <receiver
        android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
        tools:node="remove" />

    <!--
        WorkManager si inizializza su richiesta con la configurazione dell'app (HiltWorkerFactory, vedi
        MyCloudGalleryApp): l'inizializzatore automatico di androidx.startup va tolto, altrimenti partirebbe
        prima di Hilt con la fabbrica predefinita e i @HiltWorker non si costruirebbero.
    -->
    <provider
        android:name="androidx.startup.InitializationProvider"
        android:authorities="${applicationId}.androidx-startup"
        android:exported="false"
        tools:node="merge">
      <meta-data
          android:name="androidx.work.WorkManagerInitializer"
          android:value="androidx.startup"
          tools:node="remove" />
    </provider>
  </application>

</manifest>
