<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

  <application>

    <!--
        SOLO la variante di misura (benchmarkRelease, Fase 3, D21): il ProfileInstallReceiver che il manifest principale
        toglie da tutte le varianti torna qui. E' il receiver di androidx.profileinstaller (esportato, protetto dal solo
        permesso DUMP) con cui il Macrobenchmark installa e salva il profilo con un broadcast. Non esiste nella release:
        verifyReleaseManifest lo vieta (`forbiddenComponents`) e tools/check.ps1 lo cerca nell'APK.
    -->
    <receiver
        android:name="androidx.profileinstaller.ProfileInstallReceiver"
        android:directBootAware="false"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.DUMP"
        tools:node="replace">
      <intent-filter>
        <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
      </intent-filter>
      <intent-filter>
        <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
      </intent-filter>
      <intent-filter>
        <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
      </intent-filter>
      <intent-filter>
        <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
      </intent-filter>
    </receiver>

    <!--
        SOLO la variante di misura (P9): crea il dataset da 100 mila righe sintetiche quando il collaudo scrive il marcatore
        `bench-library.marker` in getExternalFilesDir (app/src/benchmarkRelease/.../bench/BenchDatasetProvider.kt).
        Non esportato e senza dati: e' solo il punto in cui il sistema ci da' il controllo prima di Application.onCreate.
        Senza marcatore non fa niente. `check.ps1` cerca nel dex di release qualunque classe `Bench*`.
    -->
    <provider
        android:name="dev.pampa.mycloudgallery.bench.BenchDatasetProvider"
        android:authorities="${applicationId}.bench"
        android:exported="false"
        android:initOrder="100" />

    <!--
        SOLO la variante di misura (Fase 10, P9): i comandi del collaudo al widget (BenchWidgetDriver): lega un widget grande, chiede un giro di aggiornamento o uno
        svuotamento, li ripete di continuo. Esportato ma protetto dal solo permesso DUMP, come il ProfileInstallReceiver qui sopra: lo manda solo `adb shell am broadcast`.
        Senza un comando non fa niente e all'avvio non gira nulla. Non esiste nella release: `check.ps1` cerca nel dex di release qualunque classe `Bench*`.
    -->
    <receiver
        android:name="dev.pampa.mycloudgallery.bench.BenchWidgetReceiver"
        android:exported="true"
        android:permission="android.permission.DUMP" />
  </application>
</manifest>
