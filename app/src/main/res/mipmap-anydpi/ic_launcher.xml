<?xml version="1.0" encoding="utf-8"?>
<!--
    L'icona dell'app: una nuvola di vetro colorato con i colori dell'arcobaleno.
    - primo piano: un'immagine calcolata da tools/icona/vetro.py (un solo pezzo di vetro: riflessi, luce che lo attraversa e che butta
      sullo sfondo; nessuna icona di terzi), nelle cinque densita' in mipmap-*/ic_launcher_foreground.png;
    - sfondo: in piano, scuro di base e chiaro con il tema chiaro del telefono (values/ e values-notnight/ic_launcher_colors.xml);
    - un colore solo (icone a tema di Android 13+): la sagoma della nuvola, drawable/ic_launcher_monochrome.xml.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background" />
  <foreground android:drawable="@mipmap/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
