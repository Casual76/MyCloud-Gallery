<?xml version="1.0" encoding="utf-8"?>
<!--
    Nessun dato dell'app esce dal telefono per vie che l'utente non controlla (docs/sicurezza.md, C16;
    docs/android.md, "Backup e trasferimento tra dispositivi").

    Due sezioni, entrambe con TUTTI i domini esclusi:
      - cloud-backup: il backup automatico su Google Drive;
      - device-transfer: il trasferimento da telefono a telefono (Smart Switch, cavo, Quick Share).
    `android:allowBackup="false"` da solo NON basta su Android 12+: su alcuni produttori il trasferimento
    fra dispositivi continua, e senza una sezione <device-transfer> la modalita' e' del tutto abilitata.

    Un telefono nuovo riparte da zero: nuova chiave del dispositivo, nuova approvazione dell'admin.
    I domini device_root, device_file, device_database e device_sharedpref (archiviazione protetta del
    dispositivo, quella leggibile prima dello sblocco) esistono solo per il trasferimento. L'app non li usa,
    ma si escludono tutti lo stesso: una libreria che domani scrivesse li' non porterebbe niente al telefono nuovo.
    Le credenziali cifrate e le impostazioni del blocco stanno in `noBackupFilesDir`, che nessun backup copia.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
