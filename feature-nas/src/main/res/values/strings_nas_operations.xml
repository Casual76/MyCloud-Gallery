  <string name="nas_ops_section_closed">Finite di recente</string>

  <string name="nas_ops_empty_title">Nessuna operazione</string>
  <string name="nas_ops_empty_detail">Quando sposti, rinomini o elimini qualcosa sul NAS la trovi qui, con l\'avanzamento. Puoi chiudere l\'app: va avanti da sola.</string>

